# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# --- Tuần 1: PostgreSQL (bắt buộc để chạy backend) ---
POSTGRES_USER=lad_user
POSTGRES_PASSWORD=lad_password
POSTGRES_DB=lad_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://lad_user:lad_password@localhost:5432/lad_db

# --- Tuần 3: Redis (đếm login fail bằng sliding window) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Tuần 3: MaxMind GeoLite2 ---
# Đăng ký free tại https://www.maxmind.com/en/geolite2/signup, tải GeoLite2-City.mmdb
GEOIP_DB_PATH=./geoip/GeoLite2-City.mmdb

# --- Tuần 5: JWT cho admin & WebSocket ---
JWT_SECRET_KEY=doi-chuoi-nay-thanh-random-secret-that-dai
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Frontend (Vite đọc biến bắt đầu bằng VITE_) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
