# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# --- Tuần 1: PostgreSQL (bắt buộc để chạy backend) ---
POSTGRES_USER=lad_user
POSTGRES_PASSWORD=lad_password
POSTGRES_DB=lad_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://lad_user:lad_password@localhost:5432/lad_db

# --- Tuần 3: Redis (đếm login fail bằng sliding window) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Tuần 3: MaxMind GeoLite2 ---
# Đăng ký free tại https://www.maxmind.com/en/geolite2/signup — xem docs/geoip-setup.md
GEOIP_DB_PATH=./geoip/GeoLite2-City.mmdb
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Tuần 5: JWT cho admin & WebSocket ---
JWT_SECRET_KEY=doi-chuoi-nay-thanh-random-secret-that-dai
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Tuần 6: script impossible_travel.py cần giả lập IP nguồn ---
# CHỈ bật khi demo cục bộ. TUYỆT ĐỐI KHÔNG bật nếu backend expose ra
# internet không qua reverse proxy đáng tin cậy (cho phép giả mạo IP nguồn
# tuỳ ý, né được rule theo IP). Xem app/config.py.
TRUST_FORWARDED_FOR=false

# --- Frontend (Vite đọc biến bắt đầu bằng VITE_) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Thư mục danh sách Tor/datacenter/VPN cho luật danh tiếng hạ tầng (tor_exit, datacenter_ip, vpn_ip).
#   (để trống)          -> backend/threat_intel/  = DỮ LIỆU THẬT, tải bằng `python -m scripts.update_threat_feeds` (ngoài git)
#   threat_intel_demo   -> DỮ LIỆU DEMO đã commit (dải tài liệu RFC 5737) — KHÔNG phải threat intelligence thực tế,
#                          chỉ để demo cục bộ (ví dụ attack-sim + TRUST_FORWARDED_FOR=true).
# (TEST FIXTURE của pytest/verification runner nằm ở backend/verification/fixtures/, không dùng cho runtime.)
THREAT_INTEL_DIR=
